{
	"name": "smartcart-workshop",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test --watch=false",
		"serve:ssr:smartcart-workshop": "node dist/smartcart-workshop/server/server.mjs",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"lint": "ng lint",
		"test:watch": "ng test",
		"test:coverage": "ng test --watch=false --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
		"e2e": "pnpm build && playwright test"
	},
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"dependencies": {
		"@angular/common": "^22.2.0",
		"@angular/compiler": "^22.2.0",
		"@angular/core": "^22.2.0",
		"@angular/forms": "^22.2.0",
		"@angular/platform-browser": "^22.2.0",
		"@angular/platform-server": "^22.2.0",
		"@angular/router": "^22.2.0",
		"@angular/ssr": "^22.2.2",
		"@google/genai": "^2.30.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular-eslint/builder": "22.6.0",
		"@angular/build": "^22.2.2",
		"@angular/cli": "^22.2.2",
		"@angular/compiler-cli": "^22.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^22.12.0",
		"@vitest/coverage-v8": "^5.0.4",
		"angular-eslint": "22.6.0",
		"eslint": "^10.12.0",
		"jsdom": "^30.0.0",
		"prettier": "^3.8.1",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.71.0",
		"vitest": "^5.0.0",
		"wrangler": "^4.151.0",
		"xhr2": "^0.2.1"
	}
}
